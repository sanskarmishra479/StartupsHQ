# Copy to .env.local for local development. Never commit real values (SEC-11).
# Variables mirror docs/SRS.md §9. Empty values are filled in the phase noted.

# ── Database ────────────────────────────────────────────────────────────────
# Local values match docker-compose.yml. Production: Neon pooled URL for app_rw.
DATABASE_URL=postgres://startupshq:startupshq_local@127.0.0.1:5432/startupshq
# drizzle-kit only (local and CI). Never set in Vercel (ADR-015).
MIGRATION_DATABASE_URL=postgres://startupshq:startupshq_local@127.0.0.1:5432/startupshq
# Vitest integration tests (docs/TEST_PLAN.md §3).
TEST_DATABASE_URL=postgres://startupshq:startupshq_local@127.0.0.1:5432/startupshq_test

# ── Origins (ADR-014) ───────────────────────────────────────────────────────
# Production: https://startupshq.space and https://admin.startupshq.space
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_ORIGIN=http://admin.localhost:3000

# ── Auth — Phase 6 ──────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://admin.localhost:3000

# ── Pagination cursors — Phase 3 ────────────────────────────────────────────
CURSOR_SIGNING_SECRET=

# ── Media — Phase 9 ─────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── Rate limiting — Phase 6 ─────────────────────────────────────────────────
# Local values match the redis-http service in docker-compose.yml. Production: Upstash.
UPSTASH_REDIS_REST_URL=http://127.0.0.1:8079
UPSTASH_REDIS_REST_TOKEN=startupshq_local_redis

# ── Email (Resend) — Phase 6 ────────────────────────────────────────────────
# Without a key, development prints emails to the server log instead of sending them.
# EMAIL_FROM is the sender recipients see, on a domain verified with Resend — in production
# something like noreply@startupshq.space, never a personal address.
RESEND_API_KEY=
EMAIL_FROM=

# ── Error monitoring — Phase 22 ─────────────────────────────────────────────
SENTRY_DSN=

# ── Prefill fallback (optional) — Phase 10 ──────────────────────────────────
FIRECRAWL_API_KEY=
